{
  "name": "@raphaelblaster/tether-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral XposE bridge for authenticated browser chats",
  "type": "module",
  "bin": {
    "tether": "bin/tether.js"
  },
  "files": [
    "adapter/src",
    "bin",
    "docs/assets",
    "extension/dist",
    "lib",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js && npm --prefix adapter test && npm run registry:test",
    "pack:check": "npm pack --dry-run",
    "extension:build": "npm --prefix extension run build",
    "registry:build": "node provider-adapters/scripts/build-index.mjs",
    "registry:test": "npm --prefix registry-server test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "dirty-json": "0.9.2"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "puppeteer-core": "^25.3.0"
  }
}
