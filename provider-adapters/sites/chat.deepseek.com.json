{
  "schemaVersion": 1,
  "origin": "https://chat.deepseek.com",
  "adapterVersion": 3,
  "engineVersion": 1,
  "composer": {
    "selectors": [
      "textarea[placeholder=\"Message DeepSeek\"]",
      "textarea",
      "[contenteditable=\"true\"]",
      "textarea#chat-input",
      ".chat-input textarea"
    ]
  },
  "send": {
    "selectors": [
      "div[role=\"button\"].ds-button.ds-button--primary.ds-button--filled.ds-button--circle",
      "button[type=\"submit\"]",
      "div[role=\"button\"][aria-label*=\"Send\" i]",
      "button[aria-label*=\"Send\" i]",
      ".send-button"
    ]
  },
  "response": {
    "turnSelectors": [
      ".ds-message:has(.ds-assistant-message-main-content)",
      ".message-assistant",
      "[class*=\"assistant\"]"
    ],
    "contentSelectors": [
      ".ds-assistant-message-main-content"
    ],
    "excludeSelectors": []
  },
  "completion": {
    "stopSelectors": [
      "button[aria-label*=\"Stop\" i]"
    ],
    "progressSelectors": [
      "div[role=\"button\"].ds-button.ds-button--primary.ds-button--filled.ds-button--circle .ds-loading"
    ]
  }
}
